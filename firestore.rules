rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the requesting user is the Admin
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'v77KWCs1rab7dQgNKOnA6M17nTP2';
    }

    // Helper: Check if the requesting user is any authenticated member
    function isMember() {
      return request.auth != null;
    }

    match /posts/{postId} {
      // Anyone can read published posts (Landing/Archive cards need this)
      // Admin can read all posts including drafts
      allow read: if resource.data.status == 'published' || isAdmin();

      // Hearts: any visitor can increment by exactly 1 (anonymous engagement)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
                     && request.resource.data.hearts == resource.data.hearts + 1;

      // Admin-only: full write access (create, update all fields, delete)
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isMember();
      allow update, delete: if isAdmin();
    }
  }
}
