rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the requesting user is the Admin
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'v77KWCs1rab7dQgNKOnA6M17nTP2';
    }

    // Helper: Check if the requesting user is any authenticated member
    function isMember() {
      return request.auth != null;
    }

    // Helper: Validate that a string field exists and is within length bounds
    function isValidString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    match /posts/{postId} {
      // Anyone can read any published post (Metadata needed for Landing Page)
      allow read: if resource.data.status == 'published' || isAdmin();

      // Hearts: any visitor can increment by exactly 1 (anonymous engagement)
      // Locked down: only the 'hearts' field can change, and only by +1
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
                     && request.resource.data.hearts == resource.data.hearts + 1;

      // Admin-only: full write access (create, update all fields, delete)
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;

      // Authenticated users can create comments with validation:
      // - Must include required fields: author, content, postId
      // - Content must be a string, max 2000 characters (prevent DB flooding)
      // - Author name max 100 characters
      // - The uid field must match the authenticated user (prevents impersonation)
      allow create: if isMember()
                    && request.resource.data.keys().hasAll(['author', 'content', 'postId', 'createdAt', 'uid'])
                    && isValidString(request.resource.data.content, 2000)
                    && isValidString(request.resource.data.author, 100)
                    && isValidString(request.resource.data.postId, 200)
                    && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      // Only authenticated users can subscribe (prevents anonymous spam flooding)
      // - The subscriberId (document ID) must match the user's email
      // - Email field must match the document ID
      // - Name is optional but capped at 100 chars
      allow create: if isMember()
                    && subscriberId == request.auth.token.email
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.status == 'pending'
                    && (!('name' in request.resource.data) || request.resource.data.name.size() <= 100);

      allow read: if (request.auth != null && request.auth.token.email == subscriberId) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
